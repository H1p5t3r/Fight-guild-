extends SceneTree

var failures := 0
var checks := 0
func check(value: bool, message: String) -> void:
	checks += 1
	if not value: failures += 1; push_error(message)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var model := CombatModel.new()
	var current: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/workshop/current.json"))
	check(model.load_file("res://data/workshop/" + str(current.file)).is_empty(), "Current kit failed to load")
	var atlas: Texture2D = load(CombatStatusEffects.DIRECTORY + str(CombatStatusEffects.catalog.file))
	for name in CombatStatusEffects.catalog.frames:
		var texture := CombatStatusEffects.texture(name)
		check(texture != null and texture.region.size.x > 0 and texture.region.size.y > 0, "Missing status artwork: " + name)
		check(Rect2(Vector2.ZERO, atlas.get_size()).encloses(texture.region), "Status artwork leaves its original atlas")
	var arena = load("res://scripts/arena.gd").new()
	root.add_child(arena); arena.size = Vector2(1280, 720)
	model.reset([5,4])
	check(CombatStatusEffects.describe(model.state()).is_empty(), "Neutral has a status effect")
	check(model.core.preview_status(1,1,40), "Bleed setup failed")
	var state := model.state()
	var saved := state.duplicate(true)
	var before := model.state_hash()
	var cues := CombatStatusEffects.describe(state)
	check(cues.size() == 1 and cues[0].kind == "bleed" and cues[0].player == 1 and cues[0].grey == 40, "Bleed belongs to the wrong fighter or loses its cash-out value")
	arena.refresh(model, state, false, false)
	var placed: Array = arena.status_cues.duplicate(true)
	arena.refresh(model, state, false, true)
	arena.refresh(model, state, false, true)
	check(arena.status_cues == placed and model.state_hash() == before and state == saved, "Pause/repaint changed status clocks or combat state")
	check(arena.impact_layer.get_index() > arena.sprites[0].get_index() and arena.impact_layer.get_index() < arena.hud_layer.get_index(), "Status seals are hidden behind fighters or cover the HUD")
	var snap := model.core.snapshot()
	for tick in 37: model.step(0,0)
	var expected := CombatStatusEffects.describe(model.state())
	check(expected[0].grey > 40, "Bleed tick never increased the displayed grey life")
	check(model.core.restore(snap), "Status snapshot restore failed")
	for tick in 37: model.step(0,0)
	check(CombatStatusEffects.describe(model.state()) == expected, "Rollback/replay changed status animation timing")
	var quiet := CombatStatusEffects.describe(model.state(), true)
	check(quiet[0].clock == 0 and quiet[0].pulse == 0.35 and quiet[0].grey == expected[0].grey, "Reduced motion removes status information or keeps pulse motion")
	for tick in 420: model.step(0,0)
	check(CombatStatusEffects.describe(model.state()).is_empty(), "Expired bleed left an effect")
	check(model.core.restore(snap), "Rollback to active bleed failed")
	check(CombatStatusEffects.describe(model.state()) == cues, "Rollback could not restore an expired visual")
	model.core.preview_place(0,40000,0,0); model.core.preview_place(1,64000,0,0)
	check(model.core.preview_begin(0,45), "Bleed cash-out setup failed")
	for tick in 110: model.step(0,0)
	check(model.state().players[1].health < 1000 and CombatStatusEffects.describe(model.state()).is_empty(), "Cash-out leaves the bleed mark or HUD tag")
	# A hitstop must hold the status even as the world frame number advances.
	model.reset([5,4]); model.core.preview_status(1,1,40)
	model.core.preview_place(0,47000,0,0); model.core.preview_place(1,53000,0,0)
	model.core.preview_begin(0,0)
	for tick in 30:
		model.step(0,0)
		if model.state().hitstop > 1: break
	check(model.state().hitstop > 1, "Hitstop setup missed")
	var held := CombatStatusEffects.describe(model.state())
	model.step(0,0)
	check(CombatStatusEffects.describe(model.state()) == held, "Hitstop advanced a status pulse")
	for mirrored in [false,true]:
		model.reset([4,5])
		model.core.preview_place(0,65000 if mirrored else 35000,0,0)
		model.core.preview_place(1,35000 if mirrored else 65000,0,0)
		check(model.core.preview_status(1,2,14), "Tether setup failed")
		arena.refresh(model, model.state(), false, false)
		var tether: Dictionary = arena.status_cues[0]
		check(tether.kind == "tether" and not tether.pulling, "Attachment falsely presents as a pull")
		check((tether.start.x > tether.point.x) == mirrored, "Mirrored cord connects to the wrong owner")
		check(CombatStatusEffects.line_point(tether,0,1) == tether.start and CombatStatusEffects.line_point(tether,1,1) == tether.point, "Cord endpoints drift away from the fighters")
		model.core.preview_begin(0,22)
		for tick in 11: model.step(0,0)
		model.step(0,16)
		var target: Dictionary = model.state().players[1]
		var pull := CombatStatusEffects.describe(model.state())
		check(pull.size() == 1 and pull[0].pulling and target.tetherSource == 0, "Consumed tether vanishes before its active pull ends")
		check(target.move == 0 and target.stun == 0 and target.health == 1000, "Pull presentation changed the opponent's ability to punch")
		for tick in 25: model.step(0,0)
		check(CombatStatusEffects.describe(model.state()).is_empty(), "Completed pull left a seal, cord or tag")
	model.reset([4,5]); model.core.preview_status(1,2,14)
	for tick in 181: model.step(0,0)
	check(CombatStatusEffects.describe(model.state()).is_empty(), "Expired tether left a cord")
	model.reset([4,5]); model.core.preview_status(1,2,14)
	model.core.preview_place(0,20000,0,0); model.core.preview_place(1,80000,0,0)
	model.step(0,0)
	check(CombatStatusEffects.describe(model.state()).is_empty(), "Out-of-range tether left a cord")
	model.reset([4,5]); model.core.preview_status(1,2,14)
	model.core.preview_place(0,52000,0,0); model.core.preview_place(1,48000,0,0)
	model.core.preview_begin(1,0)
	for tick in 30: model.step(0,0)
	check(model.state().players[0].health < 1000 and CombatStatusEffects.describe(model.state()).is_empty(), "Hitting the tether owner did not remove the effect")
	model.reset([5,4]); model.core.preview_status(1,1,40); model.core.preview_status(0,2,14)
	check(CombatStatusEffects.describe(model.state()).size() == 2, "Concurrent bleed and tether hide one another")
	state = model.state(); state.wallBreakTime = 1
	check(CombatStatusEffects.describe(state).is_empty(), "Stage travel draws a cord across its cinematic")
	model.reset()
	check(CombatStatusEffects.describe(model.state()).is_empty(), "Round reset retained effects")
	arena.queue_free(); await process_frame
	print("Status VFX: %d checks / %d failures" % [checks,failures])
	quit(1 if failures else 0)
