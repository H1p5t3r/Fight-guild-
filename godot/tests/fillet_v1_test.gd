extends SceneTree
var failures := 0
func check(ok: bool, text: String) -> void:
	if not ok: failures += 1; push_error(text)
func _initialize() -> void:
	var model := CombatModel.new()
	var initial := model.data()
	check(initial.schema == 25 and initial.characters[5].moves.size() == 47, "v23 / 47 slots")
	check(initial.characters[5].extensions.params.bleedDuration == 420, "Owned bleed parameters")
	check(model.load_data(initial).is_empty(), "Complete default extension round trip")
	check(model.data() == initial, "No extension or art metadata lost")
	var broken := initial.duplicate(true)
	broken.characters[5].moves[0].erase("extensions")
	check(not model.load_data(broken).is_empty() and model.data() == initial, "Partial kit rejected atomically")
	var archive: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/workshop/2026-11-19-slash-sweeps/FightGuild-Slash-Sweeps.json"))
	check(model.load_data(archive).is_empty(), "Archived schema 22 accepted")
	check(model.extension(5,-1).is_empty() and model.move(5,45).enabled == 0, "Older file does not silently activate v1")
	check(model.move(5,13).mechanic == 2, "Older Drive behavior retained")
	model.restore_defaults()
	model.reset([5,4])
	model.core.preview_place(0,40000,0,0)
	model.core.preview_place(1,64000,0,0)
	check(model.core.preview_status(1,1,59), "Owned bleed preview setup")
	check(model.core.preview_begin(0,45), "Isolated paired capture fixture")
	for i in 22: model.step(0,0)
	check(model.state().pairKind == 2, "Command capture reached")
	var snapshot := model.core.snapshot()
	for i in 65: model.step(0,0)
	var checksum := model.state_hash()
	check(model.state().players[1].health == 886 and model.state().players[1].bleedTime == 0, "55 + 59 paid once")
	check(model.core.restore(snapshot), "Paired snapshot accepted")
	for i in 65: model.step(0,0)
	check(model.state_hash() == checksum, "Paired snapshot replay identical")
	print("Godot Fillet v1 data, migration, paired capture and rollback: %d failures" % failures)
	quit(1 if failures else 0)
