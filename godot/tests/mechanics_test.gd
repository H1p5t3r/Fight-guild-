extends SceneTree
var failures := 0
func check(value: bool, message: String) -> void:
	if not value: failures += 1; push_error(message)
func _initialize() -> void:
	var model := CombatModel.new()
	var batch: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/workshop/current.json"))
	var source: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/workshop/" + batch.file))
	check(model.load_data(source).is_empty(), "Mechanic migration failed")
	check(model.move(5, 13).mechanic == 2 and model.move(4, 22).mechanic == 1, "Migrated Drives missing")
	check(model.move(5, 13).bleedDuration == 420, "Bleed timeout default missing")
	model.reset([5, 4], [false, false])
	for i in 30: model.step(2, 1)
	model.step(0, 0)
	model.step(256, 0)
	for i in 100: model.step(0, 0)
	check(model.state().players[1].bleedTime > 0 and model.state().players[1].greyLife > 0, "Native bleed did not apply")
	var snapshot := model.core.snapshot()
	model.step(256, 0)
	for i in 80: model.step(0, 0)
	check(model.state().players[0].variant == 2, "Native cash-out did not replace D")
	check(model.state().players[1].greyLife == 0 and model.state().players[1].health < 900, "Native cash-out did not convert grey life")
	var expected := model.core.checksum()
	check(model.core.restore(snapshot), "Native status snapshot rejected")
	model.step(256, 0)
	for i in 80: model.step(0, 0)
	check(model.core.checksum() == expected, "Native cash-out replay diverged")
	var saved := model.data()
	saved.characters[5].moves[13].bleedBlockPercent = 35
	check(model.load_data(saved).is_empty() and model.move(5, 13).bleedBlockPercent == 35, "Mechanic setting did not round trip")
	saved.characters[5].moves[13].variantStartup = 1
	check(not model.load_data(saved).is_empty(), "Follow-up bypassed the startup floor")
	model.reset([4, 5], [false, false])
	for i in 30: model.step(2, 1)
	model.step(0, 0)
	model.step(256, 0)
	for i in 100: model.step(0, 0)
	check(model.state().players[1].tetherSource > 0, "Native tether missing")
	model.step(256, 0)
	for i in 10: model.step(0, 0)
	check(model.state().players[1].tetherUsed == 1, "Native pull missing")
	check(model.core.restore(model.core.snapshot()), "Native pull snapshot bounds rejected")
	print("Godot Drive mechanics, migration, snapshots and editor values: ", failures, " failures")
	quit(1 if failures else 0)
