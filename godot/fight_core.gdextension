[configuration]
entry_symbol = "fight_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libfight_core.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libfight_core.linux.template_debug.x86_64.so"
windows.debug.x86_64 = "res://bin/libfight_core.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libfight_core.windows.template_debug.x86_64.dll"
